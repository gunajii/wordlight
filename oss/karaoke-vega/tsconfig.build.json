{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2022"], "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "declaration": true, "outDir": "dist", "rootDir": "src", "strict": true, "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true, "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
