{
  "name": "@wordlight/karaoke-vega",
  "version": "0.1.0",
  "description": "Word-timed (karaoke) subtitles for React Native on Vega OS / Fire TV: accurate playhead from a coarse currentTime, word lookup, WebVTT word timestamps, Amazon Polly speech marks (UTF-8 byte offsets) and a <KaraokeLine> component.",
  "type": "module",
  "license": "MIT",
  "author": "Gunaji Mohite",
  "keywords": [
    "karaoke",
    "subtitles",
    "word-timing",
    "webvtt",
    "amazon-polly",
    "speech-marks",
    "vega",
    "fire-tv",
    "react-native",
    "read-along"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.ts",
    "prepublishOnly": "npm test && npm run build"
  },
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/react": "^18.2.0",
    "react-native": "^0.72.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gunajii/karaoke-vega.git"
  },
  "homepage": "https://github.com/gunajii/karaoke-vega#readme",
  "bugs": {
    "url": "https://github.com/gunajii/karaoke-vega/issues"
  }
}
