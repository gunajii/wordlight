# WordLight server settings (placeholders only — no secrets). The server reads environment variables; on AWS they
# come from the CloudFormation unit and .deploy.env written by infra/aws/deploy.sh. AWS credentials are NEVER put here:
# locally they come from the AWS CLI configuration (aws configure / aws configure sso), on EC2 from the instance role.
PORT=8787
HOST=127.0.0.1
AWS_REGION=ap-south-1
SPEECH=transcribe            # transcribe | scripted (LOCAL SIMULATION, refused when NODE_ENV=production)
READING_MODE=echo            # echo (the product) | free
TRANSCRIBE_STABILITY=high    # high | medium | low | none
SUMMARY=template             # template | bedrock
BEDROCK_MODEL_ID=            # e.g. apac.amazon.nova-micro-v1:0 (only with SUMMARY=bedrock)
PROGRESS=memory              # memory | dynamodb
PROGRESS_TABLE=wordlight-progress
PUBLIC_URL=https://example.invalid
MEDIA_URL=https://example.invalid
ADMIN_TOKEN=change-me        # operator endpoints; generate your own (deploy.sh does: openssl rand -hex 16)
